{
  "name": "android-localization",
  "version": "1.0.0",
  "private": true,
  "description": "Android Localization - Capacitor wrapper",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "assets": "capacitor-assets generate --android",
    "android:add": "cap add android",
    "android:sync": "npm run build:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/app": "latest",
    "@capacitor/browser": "latest",
    "@capacitor/core": "latest",
    "@capacitor/filesystem": "latest",
    "@capacitor/share": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "latest"
  }
}
